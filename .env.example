# Copy this file to .env and fill in your own values.
# .env is read only by server.js on your server — never commit it,
# and never place it inside /public.

NODE_ENV=development
PORT=3000
# The public address of the site, no trailing slash. Used in emails,
# canonical URLs, the sitemap and Google structured data.
BASE_URL=http://localhost:3000

# ── Database ─────────────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=aura_oak

# ── Auth (required in production) ────────────────────────────
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ADMIN_JWT_SECRET=
# Password for the first admin account. Leave blank to have a random
# one generated and printed once in the server log on first start.
ADMIN_INITIAL_PASSWORD=

# ── Your business (shown on the site, in emails and to Google) ─
STORE_NAME=Eagle CNC Art & Craft
STORE_TAGLINE=CNC-cut wall art, name plates, temple panels and personalised wooden gifts — precision cut, finished by hand.
STORE_EMAIL=hello@yourdomain.com
STORE_PHONE=+1 555 010 0000
# WhatsApp number with country code, digits only (adds a chat button). Blank = no button.
STORE_WHATSAPP=
STORE_STREET=123 Maple Street
STORE_CITY=Springfield
STORE_REGION=IL
STORE_POSTAL_CODE=62701
STORE_COUNTRY=IN
# Google format for search results, comma-separated: Mo-Fr 10:00-19:00, Sa 10:00-17:00
STORE_HOURS=Mo-Fr 10:00-19:00, Sa 10:00-17:00
# How hours are shown to visitors
STORE_HOURS_DISPLAY=Mon–Fri 10am–7pm · Sat 10am–5pm · Sun closed
STORE_LATITUDE=
STORE_LONGITUDE=
# Your Google Maps / Google Business Profile link
STORE_MAPS_URL=
STORE_INSTAGRAM=
STORE_FACEBOOK=
# Where new-order and contact-form alerts go (defaults to STORE_EMAIL)
STORE_NOTIFY_EMAIL=

# ── Money ────────────────────────────────────────────────────
# ISO currency code: USD, INR, CAD, GBP, AUD, EUR … and a matching locale (en-US, en-IN, en-CA, en-GB)
STORE_CURRENCY=INR
STORE_LOCALE=en-IN
STORE_DEFAULT_SHIP_COUNTRY=India
SHIPPING_FLAT_RATE=149
FREE_SHIPPING_THRESHOLD=2999
# Flat tax rate on the discounted subtotal, e.g. 18 for 18% GST. 0 = no tax line.
TAX_RATE_PERCENT=0
TAX_LABEL=Tax
RETURN_WINDOW_DAYS=30

# ── Stripe (optional) ────────────────────────────────────────
# Blank = SIMULATED checkout (no real charges). Keys: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# From Stripe → Developers → Webhooks, endpoint: BASE_URL/api/stripe/webhook
# events: payment_intent.succeeded, charge.refunded
STRIPE_WEBHOOK_SECRET=

# ── Email (optional) ─────────────────────────────────────────
# Option 1 (recommended, and required on Render's free plan, which blocks SMTP):
# Brevo HTTPS API — free 300 emails/day. brevo.com → SMTP & API → API Keys.
# Verify MAIL_FROM's address under Senders first.
BREVO_API_KEY=
MAIL_FROM=Eagle CNC Art & Craft <you@gmail.com>
# Option 2: any SMTP server (used only when BREVO_API_KEY is empty).
# Blank = emails are printed to the server log instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Eagle CNC Art & Craft <no-reply@yourdomain.com>
